[MITM]
hostname = api.account.meitu.com, vesdk.meitu.com

[Script]
meitu-vip-user = type=http-response,pattern=^https:\/\/api\.account\.meitu\.com\/users\/show_current,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/cuongta-dhcntt/shadowrocket-modules/772f83a/meitu_vip_user.js
